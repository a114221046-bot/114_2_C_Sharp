using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using System.IO;
using Microsoft.VisualBasic;

namespace WindowsFormsApp2
{
    public partial class Form1 : Form
    {
        private List<Employee> employees = new List<Employee>();

        public Form1()
        {
            InitializeComponent();
            this.FormClosing += Form1_FormClosing;
        }

        private string ShowInputDialog(string prompt, string title, string defaultValue = "")
        {
            using (Form promptForm = new Form())
            {
                promptForm.Width = 420;
                promptForm.Height = 160;
                promptForm.FormBorderStyle = FormBorderStyle.FixedDialog;
                promptForm.Text = title;
                promptForm.StartPosition = FormStartPosition.CenterParent;
                Label textLabel = new Label() { Left = 10, Top = 10, Text = prompt, AutoSize = true };
                TextBox textBox = new TextBox() { Left = 10, Top = 40, Width = 380, Text = defaultValue };
                Button confirmation = new Button() { Text = "OK", Left = 220, Width = 80, Top = 70, DialogResult = DialogResult.OK };
                Button cancel = new Button() { Text = "Cancel", Left = 310, Width = 80, Top = 70, DialogResult = DialogResult.Cancel };
                confirmation.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;
                cancel.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;
                promptForm.Controls.Add(textBox);
                promptForm.Controls.Add(confirmation);
                promptForm.Controls.Add(cancel);
                promptForm.Controls.Add(textLabel);
                promptForm.AcceptButton = confirmation;
                promptForm.CancelButton = cancel;
                var dr = promptForm.ShowDialog();
                return dr == DialogResult.OK ? textBox.Text : string.Empty;
            }
        }

        private void RefreshEmployeeList()
        {
            listBoxEmployees.Items.Clear();
            foreach (var emp in employees)
            {
                listBoxEmployees.Items.Add($"{emp.IdNumber} {emp.Name}");
            }
        }

        private string DataFilePath => Path.Combine(Application.StartupPath, "employees.txt");

        private void LoadEmployeesFromFile()
        {
            employees.Clear();
            try
            {
                if (!File.Exists(DataFilePath))
                    return;
                var lines = File.ReadAllLines(DataFilePath);
                foreach (var line in lines)
                {
                    if (string.IsNullOrWhiteSpace(line))
                        continue;
                    var parts = line.Split('|');
                    if (parts.Length < 4)
                        continue;
                    if (!int.TryParse(parts[0], out int id))
                        continue;
                    employees.Add(new Employee(parts[1], id, parts[2], parts[3]));
                }
            }
            catch
            {
                // ignore load errors
            }
        }

        private void SaveEmployeesToFile()
        {
            try
            {
                var lines = employees.Select(emp => $"{emp.IdNumber}|{emp.Name}|{emp.Department}|{emp.Position}");
                File.WriteAllLines(DataFilePath, lines, Encoding.UTF8);
            }
            catch
            {
                // ignore save errors
            }
        }

        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            SaveEmployeesToFile();
        }

        private void btnAdd_Click(object sender, EventArgs e)
        {
            using (var f = new AddEmployeeForm(employees))
            {
                f.StartPosition = FormStartPosition.CenterParent;
                f.ShowDialog(this);
            }
            RefreshEmployeeList();
        }

        private void btnDelete_Click(object sender, EventArgs e)
        {
            using (var f = new DeleteEmployeeForm(employees))
